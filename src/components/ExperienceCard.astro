---
import type { CollectionEntry } from 'astro:content';
import { formatPeriod, localize, useTranslations, type Locale } from '../i18n/utils';

interface Props {
	experience: CollectionEntry<'experiences'>['data'];
	locale: Locale;
	/** Posição na lista ("01"). */
	index: string;
	/** Começa aberta (a mais recente). */
	open?: boolean;
}

const { experience, locale, index, open = false } = Astro.props;
const t = useTranslations(locale);
const { company, companyNote, role, start, end, summary, highlights, stack } = experience;
---

<!-- Acordeão nativo: abre e fecha sem JavaScript, pelo mouse e pelo teclado -->
<details class="experience" open={open}>
	<summary>
		<span class="index" aria-hidden="true">{index}</span>
		<h3 class="heading">
			<span class="company">
				{company}
				{companyNote && <span class="note">{localize(companyNote, locale)}</span>}
			</span>
			<span class="role">{localize(role, locale)}</span>
		</h3>
		<span class="period">{formatPeriod(start, end, locale)}</span>
		<span class="toggle" aria-hidden="true"></span>
	</summary>

	<div class="body">
		<p class="summary">{localize(summary, locale)}</p>
		<ul class="highlights">
			{localize(highlights, locale).map((item) => <li>{item}</li>)}
		</ul>
		<h4 class="visually-hidden">{t.experience.stack}</h4>
		<ul class="stack">
			{stack.map((tech) => <li>{tech}</li>)}
		</ul>
	</div>
</details>

<style>
	.experience {
		border-top: 1px solid var(--color-border);
	}

	summary {
		display: grid;
		grid-template-columns: 2.5rem 1fr auto;
		align-items: center;
		gap: var(--space-2) var(--space-4);
		padding-block: var(--space-5);
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.index {
		align-self: start;
		padding-top: 0.35rem;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
	}

	.heading {
		display: grid;
		gap: var(--space-1);
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
	}

	.note {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		font-weight: var(--weight-regular);
	}

	.note::before {
		content: ' · ';
	}

	.role {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		font-weight: var(--weight-regular);
	}

	.period {
		grid-column: 2;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		text-transform: uppercase;
	}

	/* Ícone + que vira × ao abrir */
	.toggle {
		position: relative;
		grid-column: 3;
		grid-row: 1;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		transition: transform var(--duration-base) ease;
	}

	.toggle::before,
	.toggle::after {
		content: '';
		position: absolute;
		inset: 50% auto auto 50%;
		width: 0.875rem;
		height: 2px;
		background-color: var(--color-accent);
		transform: translate(-50%, -50%);
	}

	.toggle::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}

	.experience[open] .toggle {
		transform: rotate(45deg);
	}

	summary:hover .company {
		color: var(--color-accent);
	}

	.body {
		display: grid;
		gap: var(--space-4);
		padding-bottom: var(--space-6);
	}

	/* No celular, o complemento da empresa vai para a própria linha, sem o ponto separador */
	@media (max-width: 59.99rem) {
		.note {
			display: block;
		}

		.note::before {
			content: none;
		}
	}

	.summary {
		font-weight: var(--weight-semibold);
	}

	.highlights {
		display: grid;
		gap: var(--space-2);
		padding-left: var(--space-5);
		color: var(--color-text-muted);
	}

	.highlights li::marker {
		color: var(--color-accent);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: 0;
		list-style: none;
	}

	.stack li {
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
	}

	@media (min-width: 60rem) {
		summary {
			grid-template-columns: 2.5rem 1fr auto auto;
		}

		.period {
			grid-column: 3;
			grid-row: 1;
		}

		.toggle {
			grid-column: 4;
		}

		.body {
			max-width: 52rem;
			padding-left: calc(2.5rem + var(--space-4));
		}
	}
</style>
