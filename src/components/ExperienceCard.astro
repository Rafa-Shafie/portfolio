---
import type { CollectionEntry } from 'astro:content';
import DetailDialog from './DetailDialog.astro';
import OutcomeIcon from 'bootstrap-icons/icons/arrow-up-right.svg';
import ArrowIcon from 'bootstrap-icons/icons/arrow-right.svg';
import { isPublished } from '../data/drafts';
import { formatPeriod, localize, useTranslations, type Locale } from '../i18n/utils';

interface Props {
	experience: CollectionEntry<'experiences'>['data'];
	locale: Locale;
	/** Posição na lista ("01"). */
	index: string;
	/** Começa aberta (a mais recente). */
	open?: boolean;
	/** Identificador do arquivo (para o id do modal). */
	slug: string;
}

const { experience, locale, index, open = false, slug } = Astro.props;
const t = useTranslations(locale);
const { company, companyNote, role, start, end, summary, highlights, stack, outcome, details } = experience;
const period = formatPeriod(start, end, locale);
const dialogId = `experience-${slug}`;
const hasDetails = details && isPublished(details);
---

<!-- Acordeão nativo: abre e fecha sem JavaScript, pelo mouse e pelo teclado -->
<details class="experience" open={open}>
	<summary>
		<span class="index" aria-hidden="true">{index}</span>
		<h3 class="heading">
			<span class="company">
				{company}
				{companyNote && <span class="note">{localize(companyNote, locale)}</span>}
			</span>
			<span class="role">{localize(role, locale)}</span>
		</h3>
		<span class="period">{period}</span>
		<span class="toggle" aria-hidden="true"></span>
	</summary>

	<div class="body">
		<div class="content">
			<p class="summary">{localize(summary, locale)}</p>
			<ul class="highlights">
				{localize(highlights, locale).map((item) => <li>{item}</li>)}
			</ul>
			<h4 class="visually-hidden">{t.experience.stack}</h4>
			<ul class="stack">
				{stack.map((tech) => <li>{tech}</li>)}
			</ul>
		</div>

		<!-- Painel "Entrega & aprendizado": o resultado em uma frase e o caminho para os detalhes -->
		{
			(outcome || hasDetails) && (
				<div class="outcome">
					<OutcomeIcon class="outcome-icon" aria-hidden="true" />
					<p class="outcome-label">{t.experience.outcome}</p>
					{outcome && <p class="outcome-text">{localize(outcome, locale)}</p>}
					{hasDetails && (
						<button class="explore" type="button" data-dialog-open={dialogId} aria-haspopup="dialog" hidden>
							{t.experience.explore}
							<span class="visually-hidden">: {company}, {localize(role, locale)}</span>
							<ArrowIcon class="explore-arrow" aria-hidden="true" />
						</button>
					)}
				</div>
			)
		}
	</div>
</details>

{
	hasDetails && details && (
		<DetailDialog
			id={dialogId}
			eyebrow={company}
			title={localize(role, locale)}
			meta={period}
			intro={details.intro && localize(details.intro, locale)}
			sections={details.sections.map((section) => ({
				heading: localize(section.heading, locale),
				text: section.text && localize(section.text, locale),
				items: section.items && localize(section.items, locale),
			}))}
			tagsHeading={t.experience.details.tech}
			tags={stack}
			note={t.experience.details.note}
			closeLabel={t.a11y.closeDetails}
			draftLabel={details.draft ? t.a11y.draft : undefined}
		/>
	)
}

<style>
	.experience {
		border-top: 1px solid var(--color-border);
	}

	summary {
		display: grid;
		grid-template-columns: 2.5rem 1fr auto;
		align-items: center;
		gap: var(--space-2) var(--space-4);
		padding-block: var(--space-5);
		list-style: none;
		cursor: pointer;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	.index {
		align-self: start;
		padding-top: 0.35rem;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
	}

	.heading {
		display: grid;
		gap: var(--space-1);
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
	}

	.note {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		font-weight: var(--weight-regular);
	}

	.note::before {
		content: ' · ';
	}

	.role {
		color: var(--color-text-muted);
		font-size: var(--text-base);
		font-weight: var(--weight-regular);
	}

	.period {
		grid-column: 2;
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		text-transform: uppercase;
	}

	/* Ícone + que vira × ao abrir */
	.toggle {
		position: relative;
		grid-column: 3;
		grid-row: 1;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		transition: transform var(--duration-base) ease;
	}

	.toggle::before,
	.toggle::after {
		content: '';
		position: absolute;
		inset: 50% auto auto 50%;
		width: 0.875rem;
		height: 2px;
		background-color: var(--color-accent);
		transform: translate(-50%, -50%);
	}

	.toggle::after {
		transform: translate(-50%, -50%) rotate(90deg);
	}

	.experience[open] .toggle {
		transform: rotate(45deg);
	}

	summary:hover .company {
		color: var(--color-accent);
	}

	.body {
		display: grid;
		gap: var(--space-6);
		padding-bottom: var(--space-6);
	}

	.content {
		display: grid;
		align-content: start;
		gap: var(--space-4);
	}

	/* No celular, o complemento da empresa vai para a própria linha, sem o ponto separador */
	@media (max-width: 59.99rem) {
		.note {
			display: block;
		}

		.note::before {
			content: none;
		}
	}

	.summary {
		font-weight: var(--weight-semibold);
	}

	.highlights {
		display: grid;
		gap: var(--space-2);
		padding-left: var(--space-5);
		color: var(--color-text-muted);
	}

	.highlights li::marker {
		color: var(--color-accent);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: 0;
		list-style: none;
	}

	.stack li {
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
	}

	.outcome {
		display: grid;
		align-self: start;
		align-content: start;
		justify-items: start;
		gap: var(--space-3);
		padding: var(--space-6);
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	.outcome-icon {
		width: 1.25rem;
		height: 1.25rem;
		margin-bottom: var(--space-2);
		color: var(--color-accent);
	}

	.outcome-label {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.outcome-text {
		font-size: var(--text-lg);
		font-weight: var(--weight-regular);
		line-height: 1.4;
	}

	/* Link de texto com seta, no lugar do botão cheio */
	.explore {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		min-height: 2.75rem;
		margin-top: var(--space-1);
		padding: 0;
		background: none;
		border: 0;
		color: var(--color-text);
		font-weight: var(--weight-semibold);
		cursor: pointer;
		transition: color var(--duration-fast) ease;
	}

	.explore-arrow {
		width: 1rem;
		height: 1rem;
		transition: transform var(--duration-base) ease;
	}

	.explore:hover {
		color: var(--color-accent);
	}

	.explore:hover .explore-arrow {
		transform: translateX(4px);
	}

	@media (prefers-reduced-motion: reduce) {
		.explore:hover .explore-arrow {
			transform: none;
		}
	}

	@media (min-width: 60rem) {
		summary {
			grid-template-columns: 2.5rem 1fr auto auto;
		}

		.period {
			grid-column: 3;
			grid-row: 1;
		}

		.toggle {
			grid-column: 4;
		}

		/* Destaques à esquerda, painel de resultado à direita */
		.body {
			grid-template-columns: minmax(0, 1fr) minmax(16rem, 23rem);
			gap: var(--space-7);
			padding-left: calc(2.5rem + var(--space-4));
		}
	}
</style>
