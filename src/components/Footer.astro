---
/** Rodapé: continua o bloco de destaque do contato, com a marca, os links e o ano. */
import BrandMark from '../assets/brand/mark.svg';
import { profile } from '../data/profile';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
// O ano é calculado no build, não no navegador: o "© 2026" atualiza no primeiro deploy do ano novo
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<!-- Assinatura da página: a marca em escuro sobre o ciano -->
		<BrandMark class="footer-mark" aria-hidden="true" />
		<p>© {year} {profile.name}. {t.footer.builtWith}</p>
	</div>
</footer>

<style>
	/* Continua o bloco ciano do contato: a página termina toda no destaque */
	.site-footer {
		padding-block: var(--space-6);
		background-color: var(--color-accent);
		color: var(--color-on-accent);
		font-size: var(--text-sm);
	}

	.footer-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
		padding-top: var(--space-6);
		border-top: 1px solid color-mix(in srgb, var(--color-on-accent) 22%, transparent);
		text-align: center;
	}

	.footer-mark {
		width: 2.5rem;
		height: 2.5rem;
		color: var(--color-on-accent);
	}

	/* Sobre o ciano, a marca fica de uma cor só: o S ciano sumiria aqui */
	.footer-mark :global(.mark-r) {
		fill: currentColor;
		stroke: currentColor;
	}

	@media (min-width: 40rem) {
		.footer-inner {
			flex-direction: row;
			justify-content: space-between;
			text-align: left;
		}
	}
</style>
