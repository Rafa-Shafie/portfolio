---
/**
 * Modal de detalhes (experiências, projetos e formação), com <dialog> nativo + showModal():
 * foco preso no modal, Esc fecha e o resto da página fica inerte. O script abaixo cuida de abrir
 * pelos botões [data-dialog-open], fechar ao clicar fora e devolver o foco a quem abriu.
 */
import CloseIcon from 'bootstrap-icons/icons/x-lg.svg';
import ArrowIcon from 'bootstrap-icons/icons/arrow-right.svg';
import PdfIcon from 'bootstrap-icons/icons/file-earmark-pdf.svg';
import ExternalIcon from 'bootstrap-icons/icons/box-arrow-up-right.svg';
import CopyIcon from 'bootstrap-icons/icons/copy.svg';
import CheckIcon from 'bootstrap-icons/icons/check2.svg';
import Diagram, { type DiagramName } from './Diagram.astro';
import type { Locale } from '../i18n/utils';

interface Section {
	heading: string;
	text?: string;
	items?: string[];
	/** Diagrama ilustrativo, desenhado antes do texto da seção. */
	diagram?: DiagramName;
}

/** Bloco de links para outros modais (experiência ↔ projeto). `id` é o id do outro <dialog>. */
interface Related {
	heading: string;
	text: string;
	links: { label: string; id: string }[];
}

/** Comprovantes (formação): os PDFs em cartões e o código para conferir a autenticidade. */
interface Proofs {
	heading: string;
	documents: { label: string; href: string }[];
	verification?: {
		label: string;
		url: string;
		code: string;
		codeLabel: string;
		copyLabel: string;
		copiedLabel: string;
		copyFailedLabel: string;
	};
	newTabLabel: string;
}

interface Props {
	id: string;
	/** Idioma da página (para os rótulos dos diagramas). */
	locale: Locale;
	title: string;
	/** Linha pequena acima do título (empresa, área…). */
	eyebrow?: string;
	/** Linha abaixo do título (cargo, período…). */
	meta?: string;
	/** Resumo no topo (problema, participação, entrega, resultado), antes da abertura. */
	summaryHeading?: string;
	summary?: { label: string; text: string }[];
	/** Parágrafo de abertura, antes das seções. */
	intro?: string;
	sections: Section[];
	tagsHeading?: string;
	tags?: string[];
	/** Tecnologias em detalhe, agrupadas por frente. */
	groupsHeading?: string;
	groups?: { label: string; items: string[] }[];
	links?: { label: string; href: string; newTabLabel: string }[];
	proofs?: Proofs;
	related?: Related;
	note?: string;
	closeLabel: string;
	/** Marca visível de rascunho (só aparece no dev e no preview). */
	draftLabel?: string;
}

const {
	id,
	locale,
	title,
	eyebrow,
	meta,
	summaryHeading,
	summary = [],
	intro,
	sections,
	tagsHeading,
	tags = [],
	groupsHeading,
	groups = [],
	links = [],
	proofs,
	related,
	note,
	closeLabel,
	draftLabel,
} = Astro.props;
const titleId = `${id}-title`;
---

<dialog id={id} class="detail-dialog" aria-labelledby={titleId}>
	<div class="dialog-inner">
		<header class="dialog-head">
			<div>
				{eyebrow && <p class="eyebrow">{eyebrow}</p>}
				<h2 id={titleId} class="dialog-title">{title}</h2>
				{meta && <p class="meta">{meta}</p>}
				{draftLabel && <p class="draft">{draftLabel}</p>}
			</div>
			<button class="close" type="button" data-dialog-close aria-label={closeLabel}>
				<CloseIcon aria-hidden="true" />
			</button>
		</header>

		{
			summary.length > 0 && (
				<section class="summary">
					<h3 class="block-title">{summaryHeading}</h3>
					<dl class="summary-list">
						{summary.map(({ label, text }) => (
							<div class="summary-item">
								<dt>{label}</dt>
								<dd>{text}</dd>
							</div>
						))}
					</dl>
				</section>
			)
		}

		{intro && <p class="intro">{intro}</p>}

		{
			sections.map(({ heading, text, items, diagram }) => (
				<section class="block">
					<h3 class="block-title">{heading}</h3>
					{diagram && <Diagram name={diagram} locale={locale} />}
					{text && <p class="block-text">{text}</p>}
					{items && (
						<ul class="block-list">
							{items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					)}
				</section>
			))
		}

		{
			tags.length > 0 && (
				<section class="block">
					<h3 class="block-title">{tagsHeading}</h3>
					<ul class="tags">
						{tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				</section>
			)
		}

		{
			groups.length > 0 && (
				<section class="block">
					<h3 class="block-title">{groupsHeading}</h3>
					<dl class="groups">
						{groups.map(({ label, items }) => (
							<div class="group">
								<dt>{label}</dt>
								<dd>{items.join(' · ')}</dd>
							</div>
						))}
					</dl>
				</section>
			)
		}

		{
			proofs && (
				<section class="block">
					<h3 class="block-title">{proofs.heading}</h3>
					<ul class="docs">
						{proofs.documents.map(({ label, href }) => (
							<li>
								<a class="doc" href={href} target="_blank" rel="noopener">
									<PdfIcon class="doc-icon" aria-hidden="true" />
									<span class="doc-text">
										<span class="doc-label">{label}</span>
										<span class="doc-type">PDF</span>
									</span>
									<ExternalIcon class="doc-external" aria-hidden="true" />
									<span class="visually-hidden">{proofs.newTabLabel}</span>
								</a>
							</li>
						))}
					</ul>
					{proofs.verification && (
						<div class="verify">
							<p class="verify-code">
								<span class="verify-label">{proofs.verification.codeLabel}</span>
								<code>{proofs.verification.code}</code>
								{/* Escondido até o script confirmar que dá para copiar: sem área de transferência, nada de botão morto */}
								<button
									class="copy"
									type="button"
									hidden
									data-copy-code={proofs.verification.code}
									data-ok={proofs.verification.copiedLabel}
									data-fail={proofs.verification.copyFailedLabel}
								>
									<CopyIcon class="copy-icon" aria-hidden="true" />
									<CheckIcon class="check-icon" aria-hidden="true" />
									<span class="visually-hidden">{proofs.verification.copyLabel}</span>
								</button>
								<span class="copy-status visually-hidden" role="status" />
							</p>
							<a class="verify-link" href={proofs.verification.url} target="_blank" rel="noopener noreferrer">
								{proofs.verification.label}
								<ExternalIcon aria-hidden="true" />
								<span class="visually-hidden">{proofs.newTabLabel}</span>
							</a>
						</div>
					)}
				</section>
			)
		}

		{
			related && related.links.length > 0 && (
				<section class="block">
					<h3 class="block-title">{related.heading}</h3>
					<p class="block-text">{related.text}</p>
					{/* Link de verdade (#id do outro modal): o script fecha este modal e abre o outro */}
					<ul class="related">
						{related.links.map(({ label, id: target }) => (
							<li>
								<a href={`#${target}`} data-dialog-link>
									{label}
									<ArrowIcon aria-hidden="true" />
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			links.length > 0 && (
				<p class="links">
					{links.map(({ label, href, newTabLabel }) => (
						<a class="button button-secondary" href={href} target="_blank" rel="noopener noreferrer">
							{label}
							<span class="visually-hidden">{newTabLabel}</span>
						</a>
					))}
				</p>
			)
		}

		{note && <p class="note">{note}</p>}
	</div>
</dialog>

<script>
	/*
	 * Abre e fecha os modais ("Explorar a experiência" e "Ver detalhes" dos projetos).
	 *
	 * O <dialog> nativo com showModal() já faz o trabalho pesado de acessibilidade: prende o foco
	 * dentro do modal, fecha com Esc, deixa o resto da página inerte (nem clicável nem lido pelo
	 * leitor de tela) e escurece o fundo (::backdrop). O script só liga botões ao modal certo e
	 * devolve o foco a quem abriu.
	 *
	 * Este script aparece uma vez na página, mesmo com dez modais: o Astro inclui o <script> de um
	 * componente uma vez só, por mais que ele seja usado várias vezes.
	 */
	// Um único conjunto de listeners para todos os modais da página
	// `opener` lembra qual botão abriu o modal, para devolver o foco a ele no fechamento
	let opener: HTMLElement | null = null;
	// Na troca de um modal para outro (links "Experiência relacionada"), o fechamento do primeiro não
	// devolve o foco: ele só volta ao botão de origem quando o último modal fechar
	let switching = false;

	const dialogFor = (id: string) => {
		const element = id ? document.getElementById(id) : null;
		return element instanceof HTMLDialogElement && element.classList.contains('detail-dialog') ? element : null;
	};

	// O endereço acompanha o modal aberto (…/#project-atlas), então dá para copiar e mandar o link.
	// replaceState troca o endereço sem criar entrada no histórico: o Voltar do navegador continua
	// voltando de página, em vez de virar um "fechar modal" escondido.
	const setHash = (id: string | null) =>
		history.replaceState(history.state, '', id ? `#${id}` : location.pathname + location.search);

	const open = (dialog: HTMLDialogElement) => {
		dialog.showModal();
		setHash(dialog.id);
	};

	document.addEventListener('click', (event) => {
		const target = event.target as HTMLElement;

		const openButton = target.closest<HTMLElement>('[data-dialog-open]');
		if (openButton) {
			const dialog = dialogFor(openButton.dataset.dialogOpen ?? '');
			if (dialog) {
				opener = openButton;
				open(dialog);
			}
			return;
		}

		// Link para outro modal: fecha este e abre o outro, sem rolar a página até o cartão dele
		const link = target.closest<HTMLAnchorElement>('a[data-dialog-link]');
		if (link) {
			const next = dialogFor(link.hash.slice(1));
			const current = link.closest('dialog');
			if (next && current) {
				event.preventDefault();
				switching = true;
				current.close();
				open(next);
			}
			return;
		}

		if (target.closest('[data-dialog-close]')) {
			target.closest('dialog')?.close();
			return;
		}

		// Clique no fundo escurecido (fora da caixa) fecha. O fundo faz parte do próprio <dialog>, então o
		// alvo do clique é o dialog; um clique na caixa teria como alvo algo dentro dela.
		if (target instanceof HTMLDialogElement && target.open) target.close();
	});

	// Ao fechar (botão, Esc ou fundo), o foco volta para quem abriu. Sem isso, quem usa teclado ou
	// leitor de tela voltaria para o topo da página e perderia o lugar.
	for (const dialog of document.querySelectorAll<HTMLDialogElement>('dialog.detail-dialog')) {
		dialog.addEventListener('close', () => {
			// Tira o #id do endereço, a não ser que ele já aponte para o próximo modal (troca)
			if (location.hash === `#${dialog.id}`) setHash(null);
			if (switching) {
				switching = false;
				return;
			}
			opener?.focus();
			opener = null;
		});
	}

	// Os botões que abrem modais só aparecem com JavaScript
	for (const button of document.querySelectorAll<HTMLElement>('[data-dialog-open]')) button.hidden = false;

	// Quem chega por um link com #id de modal já o vê aberto. Ao fechar, o foco vai para o botão do
	// cartão daquele modal, como se a pessoa o tivesse aberto dali.
	const openFromHash = () => {
		const dialog = dialogFor(decodeURIComponent(location.hash.slice(1)));
		if (!dialog || dialog.open) return;
		// Com outro modal aberto (o #id mudou no endereço), troca de um para o outro, como nos links
		// "Experiência relacionada"; o foco continua voltando para o botão de origem
		const current = document.querySelector<HTMLDialogElement>('dialog.detail-dialog[open]');
		if (current) {
			switching = true;
			current.close();
		} else {
			opener = document.querySelector<HTMLElement>(`[data-dialog-open="${dialog.id}"]`);
		}
		open(dialog);
	};
	openFromHash();
	addEventListener('hashchange', openFromHash);

	/*
	 * Botão de copiar o código de autenticação (comprovantes da formação). Deu certo: o ícone vira um ✓
	 * (um texto ao lado empurraria o resto da linha). Deu errado: a mensagem aparece. Nos dois casos,
	 * o role="status" anuncia ao leitor de tela; depois de 2,5 s, tudo volta ao normal.
	 */
	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-code]')) {
		// Sem a API de área de transferência (navegador antigo ou página sem HTTPS), o botão fica escondido
		if (!navigator.clipboard) continue;
		button.hidden = false;
		const status = button.nextElementSibling as HTMLElement;
		let timer: number | undefined;

		button.addEventListener('click', async () => {
			// writeText pode ser recusada (permissão negada, página sem foco): o catch mostra a falha
			let ok = true;
			try {
				await navigator.clipboard.writeText(button.dataset.copyCode ?? '');
			} catch {
				ok = false;
			}
			status.textContent = (ok ? button.dataset.ok : button.dataset.fail) ?? '';
			status.classList.toggle('visually-hidden', ok);
			button.toggleAttribute('data-copied', ok);
			// Com cliques seguidos, a contagem recomeça em vez de a mensagem sumir cedo demais
			clearTimeout(timer);
			timer = window.setTimeout(() => {
				status.textContent = '';
				button.removeAttribute('data-copied');
			}, 2500);
		});
	}
</script>

<style>
	.detail-dialog {
		width: min(100% - 2rem, 46rem);
		max-height: min(100% - 2rem, 52rem);
		padding: 0;
		margin: auto;
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: 0 2rem 4rem var(--shadow-color-strong);
		color: var(--color-text);
	}

	.detail-dialog::backdrop {
		background-color: var(--color-backdrop);
		backdrop-filter: blur(4px);
	}

	/*
	 * Abertura suave: o modal surge com opacidade e um deslocamento mínimo. @starting-style define o
	 * "antes" da transição para um elemento que acabou de aparecer (o dialog sai de display: none). O
	 * fechamento é imediato. Com menos movimento pedido, o global.css zera a duração.
	 */
	.detail-dialog[open],
	.detail-dialog[open]::backdrop {
		transition:
			opacity 200ms ease,
			translate 200ms ease;
	}

	@starting-style {
		.detail-dialog[open] {
			opacity: 0;
			translate: 0 0.75rem;
		}

		.detail-dialog[open]::backdrop {
			opacity: 0;
		}
	}

	.dialog-inner {
		display: grid;
		gap: var(--space-6);
		padding: var(--space-6);
	}

	.dialog-head {
		display: flex;
		justify-content: space-between;
		align-items: start;
		gap: var(--space-4);
	}

	.eyebrow,
	.block-title {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		font-weight: var(--weight-regular);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.dialog-title {
		margin-top: var(--space-2);
		font-size: var(--text-2xl);
		font-weight: var(--weight-semibold);
		letter-spacing: -0.02em;
	}

	.meta {
		margin-top: var(--space-2);
		color: var(--color-text-muted);
	}

	.draft {
		display: inline-block;
		margin-top: var(--space-3);
		padding: var(--space-1) var(--space-3);
		border: 1px dashed var(--color-accent);
		border-radius: var(--radius-full);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
	}

	.close {
		display: grid;
		flex: none;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		background: none;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		color: var(--color-text);
		cursor: pointer;
	}

	.close svg {
		width: 1rem;
		height: 1rem;
	}

	.block {
		display: grid;
		gap: var(--space-3);
		padding-top: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.intro {
		font-size: var(--text-lg);
		line-height: 1.6;
	}

	/* Resumo: quatro respostas curtas num quadro, em duas colunas quando há espaço */
	.summary {
		display: grid;
		gap: var(--space-4);
		padding: var(--space-5);
		background-color: var(--color-bg);
		border: 1px solid var(--color-border);
		border-left: 3px solid var(--color-accent);
		border-radius: var(--radius-sm);
	}

	.summary-list {
		display: grid;
		gap: var(--space-4) var(--space-6);
	}

	.summary-item dt {
		font-weight: var(--weight-semibold);
	}

	.summary-item dd {
		margin-top: var(--space-1);
		color: var(--color-text-muted);
		font-size: var(--text-base);
		line-height: 1.55;
	}

	.related {
		display: grid;
		gap: var(--space-2);
		padding: 0;
		list-style: none;
	}

	.related a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 2.75rem;
		color: var(--color-text);
		font-weight: var(--weight-semibold);
		text-decoration: underline;
		text-decoration-color: var(--color-accent);
		text-underline-offset: 0.25em;
	}

	.related svg {
		width: 1rem;
		height: 1rem;
		color: var(--color-accent);
		transition: translate var(--duration-fast) ease;
	}

	.related a:hover svg {
		translate: 3px 0;
	}

	.groups {
		display: grid;
		gap: var(--space-3);
	}

	.group {
		display: grid;
		gap: var(--space-1);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}

	.group dt {
		font-weight: var(--weight-semibold);
	}

	.group dd {
		color: var(--color-text-muted);
		font-size: var(--text-base);
	}

	.block-text {
		color: var(--color-text-muted);
	}

	.block-list {
		display: grid;
		gap: var(--space-2);
		padding-left: var(--space-5);
		color: var(--color-text-muted);
	}

	.block-list li::marker {
		color: var(--color-accent);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}

	/* Comprovantes: um cartão por PDF, lado a lado quando há espaço */
	.docs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: var(--space-3);
		padding: 0;
		list-style: none;
	}

	.doc {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		height: 100%;
		padding: var(--space-3) var(--space-4);
		background-color: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		color: var(--color-text);
		text-decoration: none;
		transition: border-color var(--duration-fast) ease;
	}

	.doc:hover {
		border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
	}

	.doc-icon {
		flex: none;
		width: 1.5rem;
		height: 1.5rem;
		color: var(--color-accent);
	}

	.doc-text {
		display: grid;
		flex: 1;
		gap: var(--space-1);
		line-height: 1.3;
	}

	.doc-label {
		font-weight: var(--weight-semibold);
	}

	.doc-type {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-label);
	}

	.doc-external {
		flex: none;
		width: 0.875rem;
		height: 0.875rem;
		color: var(--color-text-muted);
	}

	/* Código de autenticação e o link para conferir, numa linha que quebra no celular */
	.verify {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2) var(--space-4);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.verify-code {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0 var(--space-2);
	}

	.verify-code code {
		color: var(--color-text);
		font-family: var(--font-mono);
	}

	/* 24px: o alvo mínimo de toque da WCAG 2.5.8 */
	.copy {
		display: inline-grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		padding: 0;
		background: none;
		border: 0;
		border-radius: var(--radius-sm);
		color: inherit;
		cursor: pointer;
	}

	.copy:hover {
		color: var(--color-text);
	}

	.copy svg {
		width: 0.875rem;
		height: 0.875rem;
	}

	.copy:not([data-copied]) .check-icon,
	.copy[data-copied] .copy-icon {
