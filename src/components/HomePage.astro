---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Experience from './sections/Experience.astro';
import Education from './sections/Education.astro';
import Skills from './sections/Skills.astro';
import Projects from './sections/Projects.astro';
import Contact from './sections/Contact.astro';
import Footer from './Footer.astro';
import { skillGroups } from '../data/skills';
import { profile } from '../data/profile';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

type Dated = { id: string; data: { start: string } };
const byStart = (a: Dated, b: Dated) => a.data.start.localeCompare(b.data.start) || a.id.localeCompare(b.id);

// Experiências: mais recente primeiro. Formação: na ordem do CV (a graduação, mais antiga, abre a lista).
const experiences = (await getCollection('experiences')).sort((a, b) => byStart(b, a));
const education = (await getCollection('education')).sort(byStart);
const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
);

type SectionId = keyof typeof t.nav;

// Uma seção só existe se tiver conteúdo. O menu e a página leem este mesmo mapa,
// então nenhum link aponta para uma seção ausente.
const show: Partial<Record<SectionId, boolean>> = {
	about: true,
	experience: experiences.length > 0,
	education: education.length > 0,
	skills: skillGroups.length > 0,
	projects: projects.length > 0,
	contact: true,
};

const order: SectionId[] = ['about', 'experience', 'education', 'skills', 'projects', 'contact'];
const navLinks = order.filter((id) => show[id]).map((id) => ({ id, label: t.nav[id] }));
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description}>
	<Header locale={locale} links={navLinks} />
	<main id="main">
		<Hero locale={locale}>
			{
				show.contact && (
					<a slot="actions" class="button button-primary" href="#contact">
						{t.hero.ctaContact}
					</a>
				)
			}
			<a slot="actions" class="button button-secondary" href={profile.cv[locale]} download>
				{t.hero.ctaCv}
			</a>
		</Hero>
		{show.about && <About id="about" locale={locale} />}
		{show.experience && <Experience id="experience" locale={locale} entries={experiences} />}
		{show.education && <Education id="education" locale={locale} entries={education} />}
		{show.skills && <Skills id="skills" locale={locale} groups={skillGroups} />}
		{show.projects && <Projects id="projects" locale={locale} entries={projects} />}
		{show.contact && <Contact id="contact" locale={locale} />}
	</main>
	<Footer locale={locale} />
</BaseLayout>
