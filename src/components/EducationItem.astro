---
/**
 * Um item da lista de formação: instituição, curso e período. Sem datas (o Kumon, no próprio
 * ritmo), mostra "em andamento"; sem fim, "atual" (ver formatPeriod em src/i18n/utils.ts).
 */
import type { CollectionEntry } from 'astro:content';
import { formatPeriod, localize, useTranslations, type Locale } from '../i18n/utils';

interface Props {
	education: CollectionEntry<'education'>['data'];
	locale: Locale;
}

const { education, locale } = Astro.props;
const t = useTranslations(locale);
const { institution, course, start, end } = education;
---

<li class="item">
	<div>
		<h4 class="course">{localize(course, locale)}</h4>
		<p class="institution">{institution}</p>
	</div>
	<p class="period">{start ? formatPeriod(start, end, locale) : t.period.inProgress}</p>
</li>

<style>
	.item {
		display: grid;
		gap: var(--space-1) var(--space-4);
		padding-block: var(--space-4);
		border-bottom: 1px solid var(--color-border);
	}

	.course {
		font-size: var(--text-base);
		font-weight: var(--weight-semibold);
	}

	.institution {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.period {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		text-transform: uppercase;
	}

	@media (min-width: 40rem) {
		.item {
			grid-template-columns: 1fr auto;
			align-items: baseline;
		}

		.period {
			text-align: right;
		}
	}
</style>
