---
import Section from '../Section.astro';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
	id: string;
	number: string;
	locale: Locale;
}

const { id, number, locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id={id} number={number} label={t.about.label} heading={t.about.heading}>
	<!-- As duas colunas começam com o mesmo rótulo + linha, na mesma altura -->
	<div class="about">
		<div>
			<h3 class="col-label">{t.about.bioTitle}</h3>
			<div class="bio">
				{t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>
		</div>

		<div>
			<h3 class="col-label">{t.about.contributionsTitle}</h3>
			<ol class="contributions">
				{
					t.about.contributions.map(({ title, text }, i) => (
						<li>
							<span class="n" aria-hidden="true">
								{String(i + 1).padStart(2, '0')}
							</span>
							<div>
								<p class="contribution-title">{title}</p>
								<p class="contribution-text">{text}</p>
							</div>
						</li>
					))
				}
			</ol>

			<h3 class="col-label languages-title">{t.about.languagesTitle}</h3>
			<dl class="languages">
				{
					t.about.languages.map(({ name, level }) => (
						<div>
							<dt>{name}</dt>
							<dd>{level}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
</Section>

<style>
	.about {
		display: grid;
		gap: var(--space-8);
	}

	.col-label {
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--color-border);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		font-weight: var(--weight-regular);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.bio {
		display: grid;
		gap: var(--space-4);
		max-width: 40rem;
		padding-top: var(--space-5);
		color: var(--color-text-muted);
	}

	.contributions {
		padding: 0;
		list-style: none;
	}

	.contributions li {
		display: grid;
		grid-template-columns: 2.5rem 1fr;
		padding-block: var(--space-5);
		border-bottom: 1px solid var(--color-border);
	}

	.n {
		padding-top: 0.2rem;
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
	}

	.contribution-title {
		font-weight: var(--weight-semibold);
	}

	.contribution-text {
		margin-top: var(--space-1);
		color: var(--color-text-muted);
		font-size: var(--text-base);
	}

	.languages-title {
		margin-top: var(--space-7);
	}

	.languages div {
		display: flex;
		justify-content: space-between;
		gap: var(--space-4);
		padding-block: var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}

	dt {
		font-weight: var(--weight-semibold);
	}

	dd {
		color: var(--color-text-muted);
	}

	@media (min-width: 60rem) {
		.about {
			grid-template-columns: 1.2fr 1fr;
			gap: var(--space-9);
		}
	}
</style>
