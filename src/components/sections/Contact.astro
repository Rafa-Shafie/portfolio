---
import EmailIcon from 'bootstrap-icons/icons/envelope.svg';
import LinkedInIcon from 'bootstrap-icons/icons/linkedin.svg';
import GitHubIcon from 'bootstrap-icons/icons/github.svg';
import CvIcon from 'bootstrap-icons/icons/file-earmark-arrow-down.svg';
import Section from '../Section.astro';
import { profile } from '../../data/profile';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
	id: string;
	locale: Locale;
}

const { id, locale } = Astro.props;
const t = useTranslations(locale);
---

<Section id={id} title={t.contact.title}>
	<p class="text">{t.contact.text}</p>

	<ul class="links">
		<li>
			<a class="button button-primary" href={`mailto:${profile.email}`}>
				<EmailIcon aria-hidden="true" />
				<span><span class="visually-hidden">{t.contact.email}: </span>{profile.email}</span>
			</a>
		</li>
		<li>
			<a class="button button-secondary" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
				<LinkedInIcon aria-hidden="true" />
				{t.contact.linkedin}
				<span class="visually-hidden">{t.a11y.newTab}</span>
			</a>
		</li>
		<li>
			<a class="button button-secondary" href={profile.github} target="_blank" rel="noopener noreferrer">
				<GitHubIcon aria-hidden="true" />
				{t.contact.github}
				<span class="visually-hidden">{t.a11y.newTab}</span>
			</a>
		</li>
		<li>
			<a class="button button-secondary" href={profile.cv[locale]} download>
				<CvIcon aria-hidden="true" />
				{t.contact.cv}
			</a>
		</li>
	</ul>
</Section>

<style>
	.text {
		max-width: 40rem;
		margin-bottom: var(--space-6);
		color: var(--color-text-muted);
		font-size: var(--text-lg);
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		padding: 0;
		list-style: none;
	}
</style>
