---
import type { CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import ProjectArt from '../ProjectArt.astro';
import DetailDialog from '../DetailDialog.astro';
import { localize, useTranslations, type Locale } from '../../i18n/utils';

interface Props {
	id: string;
	number: string;
	locale: Locale;
	entries: CollectionEntry<'projects'>[];
}

const { id, number, locale, entries } = Astro.props;
const t = useTranslations(locale);

// Só mostra filtros das áreas que têm projeto
const categories = (['ai', 'backend', 'data'] as const).filter((c) => entries.some((e) => e.data.category === c));
---

<Section id={id} number={number} label={t.projects.label} heading={t.projects.heading}>
	<p slot="intro">{t.projects.intro}</p>

	<!-- Filtros: só com JavaScript (sem ele, todos os projetos aparecem) e só se houver 2+ áreas -->
	{
		categories.length > 1 && (
			<>
				<div class="filters" role="group" aria-label={t.projects.filterLabel} data-project-filters hidden>
					<button type="button" class="filter" data-filter="all" aria-pressed="true">
						{t.projects.categories.all}
					</button>
					{categories.map((c) => (
						<button type="button" class="filter" data-filter={c} aria-pressed="false">
							{t.projects.categories[c]}
						</button>
					))}
				</div>
				<p class="visually-hidden" role="status" data-project-count data-label={t.projects.count} />
			</>
		)
	}

	<ul class="grid">
		{
			entries.map(({ id: slug, data }) => {
				const dialogId = `project-${slug}`;
				const title = localize(data.title, locale);
				return (
					<li class="card" data-category={data.category}>
						<ProjectArt category={data.category} uid={slug} />
						<div class="card-body">
							<p class="card-meta">
								<span class="status">{t.projects.status[data.status]}</span>
								<span class="category">{t.projects.categories[data.category]}</span>
							</p>
							{data.draft && <p class="draft">{t.a11y.draft}</p>}
							<p class="kind">
								{data.organization ? `${t.projects.kinds[data.kind]} · ${data.organization}` : t.projects.kinds[data.kind]}
							</p>
							<h3 class="card-title">{title}</h3>
							<p class="description">{localize(data.description, locale)}</p>
							<ul class="stack">
								{data.stack.map((tech) => (
									<li>{tech}</li>
								))}
							</ul>
							{data.details && (
								<button class="more" type="button" data-dialog-open={dialogId} aria-haspopup="dialog" hidden>
									{t.projects.readMore}
									<span class="visually-hidden">: {title}</span>
									<span aria-hidden="true">→</span>
								</button>
							)}
						</div>
						{data.details && (
							<DetailDialog
								id={dialogId}
								eyebrow={[data.organization ?? t.projects.kinds[data.kind], t.projects.status[data.status]].join(' · ')}
								title={title}
								intro={data.details.intro && localize(data.details.intro, locale)}
								sections={data.details.sections.map((section) => ({
									heading: localize(section.heading, locale),
									text: section.text && localize(section.text, locale),
									items: section.items && localize(section.items, locale),
								}))}
								groupsHeading={t.projects.details.techDetails}
								groups={(data.techDetails ?? []).map((g) => ({ label: localize(g.label, locale), items: g.items }))}
								tagsHeading={t.projects.details.tech}
								tags={data.stack}
								links={[
									...(data.repo ? [{ label: t.projects.repo, href: data.repo, newTabLabel: t.a11y.newTab }] : []),
									...(data.demo ? [{ label: t.projects.demo, href: data.demo, newTabLabel: t.a11y.newTab }] : []),
								]}
								closeLabel={t.a11y.closeDetails}
								draftLabel={data.draft ? t.a11y.draft : undefined}
							/>
						)}
					</li>
				);
			})
		}
	</ul>
</Section>

<script>
	const group = document.querySelector<HTMLElement>('[data-project-filters]');
	const status = document.querySelector<HTMLElement>('[data-project-count]');
	const cards = [...document.querySelectorAll<HTMLElement>('#projects .card')];

	if (group && status && cards.length > 0) {
		group.hidden = false;
		const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-filter]')];

		group.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
			if (!button) return;
			const filter = button.dataset.filter;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
			let shown = 0;
			cards.forEach((card) => {
				const match = filter === 'all' || card.dataset.category === filter;
				card.hidden = !match;
				if (match) shown++;
			});
			// Anuncia quantos projetos ficaram visíveis
			status.textContent = `${shown} ${status.dataset.label ?? ''}`;
		});
	}
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-6);
	}

	.filter {
		min-height: 2.75rem;
		padding: 0 var(--space-5);
		background: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		color: var(--color-text-muted);
		font-weight: var(--weight-semibold);
		cursor: pointer;
	}

	.filter:hover {
		color: var(--color-text);
	}

	.filter[aria-pressed='true'] {
		background-color: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-on-accent);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
		gap: var(--space-5);
		padding: 0;
		list-style: none;
	}

	.card {
		display: grid;
		grid-template-rows: auto 1fr;
		overflow: hidden;
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	.card-body {
		display: grid;
		align-content: start;
		gap: var(--space-3);
		padding: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.card-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-accent);
	}

	.status::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background-color: var(--color-accent);
	}

	.category {
		color: var(--color-text-muted);
	}

	.draft {
		justify-self: start;
		padding: var(--space-1) var(--space-3);
		border: 1px dashed var(--color-accent);
		border-radius: var(--radius-full);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
	}

	.kind {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.card-title {
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
	}

	.description {
		color: var(--color-text-muted);
		font-size: var(--text-base);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: 0;
		list-style: none;
	}

	.stack li {
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
	}

	/* Projeto único: o cartão ocupa a largura toda, com a ilustração ao lado do texto */
	@media (min-width: 60rem) {
		.grid:has(> .card:only-child) {
			grid-template-columns: minmax(0, 1fr);
		}

		.card:only-child {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
			grid-template-rows: auto;
		}

		.card:only-child .card-body {
			align-content: center;
			padding: var(--space-7);
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}

		.card:only-child :global(.art) {
			height: 100%;
			object-fit: cover;
		}
	}

	.more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		justify-self: start;
		min-height: 2.75rem;
		margin-top: var(--space-2);
		padding: 0;
		background: none;
		border: 0;
		color: var(--color-accent);
		font-weight: var(--weight-semibold);
		cursor: pointer;
	}

	.more:hover {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
