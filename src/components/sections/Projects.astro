---
import type { CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import { localize, useTranslations, type Locale } from '../../i18n/utils';

interface Props {
	id: string;
	locale: Locale;
	entries: CollectionEntry<'projects'>[];
}

const { id, locale, entries } = Astro.props;
const t = useTranslations(locale);
---

<Section id={id} title={t.projects.title}>
	<ul class="grid">
		{
			entries.map(({ data }) => (
				<li class="card">
					<h3>{localize(data.title, locale)}</h3>
					<p class="description">{localize(data.description, locale)}</p>
					<ul class="stack">
						{data.stack.map((tech) => (
							<li>{tech}</li>
						))}
					</ul>
					{(data.repo || data.demo) && (
						<p class="links">
							{data.repo && (
								<a href={data.repo} target="_blank" rel="noopener noreferrer">
									{t.projects.repo}
									<span class="visually-hidden">{t.a11y.newTab}</span>
								</a>
							)}
							{data.demo && (
								<a href={data.demo} target="_blank" rel="noopener noreferrer">
									{t.projects.demo}
									<span class="visually-hidden">{t.a11y.newTab}</span>
								</a>
							)}
						</p>
					)}
				</li>
			))
		}
	</ul>
</Section>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: var(--space-5);
		padding: 0;
		list-style: none;
	}

	.card {
		display: grid;
		gap: var(--space-3);
		align-content: start;
		padding: var(--space-5);
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}

	h3 {
		font-size: var(--text-lg);
	}

	.description {
		color: var(--color-text-muted);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		padding: 0;
		list-style: none;
	}

	.stack li {
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
	}

	.links {
		display: flex;
		gap: var(--space-4);
		font-weight: var(--weight-semibold);
	}
</style>
