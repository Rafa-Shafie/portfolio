---
/**
 * Seção "Projetos": os filtros por área e a grade de cartões, um por YAML em src/content/projects/.
 *
 * Padrão de clique do cartão: o cartão inteiro é clicável, mas existe um botão só ("Ver
 * detalhes"). O ::after do botão é esticado por cima do cartão (position: absolute; inset: 0), e
 * o anel de foco aparece no cartão com .card:has(.more:focus-visible), ou seja, "o cartão que tem
 * o botão focado pelo teclado". Nenhum elemento entre o botão e o cartão pode
 * ter `position` ou `transform`: ele viraria a referência do ::after, e a área de clique encolheria.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import ProjectArt from '../ProjectArt.astro';
import DetailDialog from '../DetailDialog.astro';
import ArrowIcon from 'bootstrap-icons/icons/arrow-up-right.svg';
import { isPublished } from '../../data/drafts';
import { localizeDetails } from '../../data/details';
import { localize, localizeTerm, useTranslations, type Locale } from '../../i18n/utils';

interface Props {
	id: string;
	number: string;
	locale: Locale;
	entries: CollectionEntry<'projects'>[];
	/** Para o link "Experiência relacionada" de cada modal. */
	experiences: CollectionEntry<'experiences'>[];
}

const { id, number, locale, entries, experiences } = Astro.props;
const t = useTranslations(locale);

// Só mostra filtros das áreas que têm projeto
const categories = (['ai', 'backend', 'data', 'frontend'] as const).filter((c) =>
	entries.some((e) => e.data.category === c || e.data.alsoIn?.includes(c)),
);
---

<Section id={id} number={number} label={t.projects.label} heading={t.projects.heading}>
	<p slot="intro">{t.projects.intro}</p>

	<!-- Filtros: só com JavaScript (sem ele, todos os projetos aparecem) e só se houver 2+ áreas -->
	{
		categories.length > 1 && (
			<>
				<div class="filters" role="group" aria-label={t.projects.filterLabel} data-project-filters hidden>
					<button type="button" class="filter" data-filter="all" aria-pressed="true">
						{t.projects.categories.all}
					</button>
					{categories.map((c) => (
						<button type="button" class="filter" data-filter={c} aria-pressed="false">
							{t.projects.categories[c]}
						</button>
					))}
				</div>
				<p class="visually-hidden" role="status" data-project-count data-label={t.projects.count} />
			</>
		)
	}

	<ul class="grid">
		{
			entries.map(({ id: slug, data }, i) => {
				const dialogId = `project-${slug}`;
				const title = localize(data.title, locale);
				const stack = data.stack.map((term) => localizeTerm(term, locale));
				const stage = data.stage && localize(data.stage, locale);
				// No modal, com as tecnologias em detalhe, as 5 etiquetas do cartão seriam repetição
				const modalTags = data.techDetails?.length ? [] : stack;
				// Link para o modal da experiência, só se ela tiver o modal publicado
				const experience = experiences.find((e) => e.id === data.experience?.id);
				const relatedExperience = experience && isPublished(experience.data.details) && {
					heading: t.dialog.relatedExperience,
					text: t.dialog.relatedExperienceText,
					links: [{ label: `${localize(experience.data.role, locale)} · ${experience.data.company}`, id: `experience-${experience.id}` }],
				};
				return (
					<li class:list={['card', { featured: data.featured }]} data-categories={[data.category, ...(data.alsoIn ?? [])].join(' ')}>
						<ProjectArt
							category={data.category}
							variant={data.art}
							uid={slug}
							code={`${t.projects.categories[data.category]} / ${String(i + 1).padStart(2, '0')}`}
							caption={data.art && t.projects.art[data.art]}
						/>
						<div class="card-body">
							<p class="card-meta">
								<span class="kind">
									{data.organization ? `${t.projects.kinds[data.kind]} · ${data.organization}` : t.projects.kinds[data.kind]}
								</span>
								<span class="status">{t.projects.status[data.status]}</span>
							</p>
							{data.draft && <p class="draft">{t.a11y.draft}</p>}
							<h3 class="card-title">{title}</h3>
							{/* Estágio atual logo abaixo do título, antes da descrição (que fala do objetivo) */}
							{stage && <p class="stage">{stage}</p>}
							<p class="description">{localize(data.description, locale)}</p>
							<ul class="stack">
								{stack.map((tech) => (
									<li>{tech}</li>
								))}
							</ul>
							{data.details && (
								<p class="card-foot">
									{/* Um só botão de verdade; a área de clique dele se estende pelo cartão inteiro */}
									{/* aria-label começa pelo texto visível (WCAG 2.5.3) e diz de qual projeto é */}
									<button
										class="more"
										type="button"
										data-dialog-open={dialogId}
										aria-haspopup="dialog"
										aria-label={`${t.projects.readMore}: ${title}`}
										hidden
									>
										{t.projects.readMore}
									</button>
									<ArrowIcon class="arrow" aria-hidden="true" />
								</p>
							)}
						</div>
						{data.details && (
							<DetailDialog
								id={dialogId}
								eyebrow={[data.organization ?? t.projects.kinds[data.kind], t.projects.status[data.status]].join(' · ')}
								title={title}
								meta={stage}
								summaryHeading={t.dialog.summary}
								{...localizeDetails(data.details, locale)}
								groupsHeading={t.projects.details.techDetails}
								groups={(data.techDetails ?? []).map((g) => ({
									label: localize(g.label, locale),
									items: g.items.map((term) => localizeTerm(term, locale)),
								}))}
								tagsHeading={t.projects.details.tech}
								tags={modalTags}
								links={[
									...(data.repo ? [{ label: t.projects.repo, href: data.repo, newTabLabel: t.a11y.newTab }] : []),
									...(data.demo ? [{ label: t.projects.demo, href: data.demo, newTabLabel: t.a11y.newTab }] : []),
								]}
								related={relatedExperience || undefined}
								closeLabel={t.a11y.closeDetails}
								draftLabel={data.draft ? t.a11y.draft : undefined}
							/>
						)}
					</li>
				);
			})
		}
	</ul>
</Section>

<script>
	/*
	 * Filtros dos projetos. Este <script> roda no navegador (diferente do frontmatter, que roda no
	 * build). O Astro junta e minifica os scripts dos componentes num arquivo só.
	 *
	 * Os filtros nascem com `hidden` no HTML: sem JavaScript eles não funcionariam, então nem
	 * aparecem, e todos os projetos ficam à vista. O script é quem os mostra.
	 */
	const group = document.querySelector<HTMLElement>('[data-project-filters]');
	const status = document.querySelector<HTMLElement>('[data-project-count]');
	const cards = [...document.querySelectorAll<HTMLElement>('#projects .card')];

	if (group && status && cards.length > 0) {
		group.hidden = false;
		const buttons = [...group.querySelectorAll<HTMLButtonElement>('[data-filter]')];

		// Um ouvinte só no grupo, em vez de um por botão ("delegação de eventos"): o clique sobe do botão
		// até o grupo, e closest() descobre qual botão foi clicado (mesmo clicando no texto dentro dele)
		group.addEventListener('click', (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
			if (!button) return;
			const filter = button.dataset.filter;
			// aria-pressed: o leitor de tela anuncia qual filtro está ligado
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
			let shown = 0;
			// Cada cartão leva as áreas em data-categories ("backend ai"); esconde os que não têm a área
			cards.forEach((card) => {
				const match = filter === 'all' || (card.dataset.categories ?? '').split(' ').includes(filter ?? '');
				card.hidden = !match;
				if (match) shown++;
			});
			// Anuncia quantos projetos ficaram visíveis. O parágrafo tem role="status": o leitor de tela lê
			// sozinho quando o texto muda, sem tirar o foco do botão (é uma "live region")
			status.textContent = `${shown} ${status.dataset.label ?? ''}`;
			centerLastRow();
		});
	}

	/*
	 * Última linha centralizada: se ela não enche a grade (ex.: um cartão sozinho), o primeiro cartão
	 * dela começa mais à direita, na coluna que deixa a linha no meio. Com dois cartões, eles ficam
	 * sob os vãos dos três de cima, como uma pirâmide invertida.
	 *
	 * O script "simula" a grade: lê quantas colunas ela tem agora (muda no tablet e no desktop) e
	 * quantas cada cartão visível ocupa, monta as linhas e mede a sobra da última. Roda ao carregar,
	 * a cada filtro e quando a tela muda de faixa. Sem JavaScript, a última linha fica à esquerda.
	 */
	function centerLastRow() {
		const grid = document.querySelector<HTMLElement>('#projects ul.grid');
		if (!grid) return;
		const visible = [...grid.querySelectorAll<HTMLElement>(':scope > .card')].filter((card) => {
			card.style.gridColumn = '';
			return !card.hidden;
		});
		const columns = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
		if (columns < 2) return;

		// Quantas colunas o cartão ocupa: "span 4" vem do CSS; "auto" é uma; uma posição fixa (o
		// projeto único, de borda a borda) conta como a linha inteira
		const spanOf = (card: HTMLElement) => {
			const start = getComputedStyle(card).gridColumnStart;
			const match = /span (\d+)/.exec(start);
			return match ? Math.min(Number(match[1]), columns) : start === 'auto' ? 1 : columns;
		};

		// Monta as linhas: um cartão que não cabe na sobra da linha atual abre a próxima
		let row: { card: HTMLElement; span: number }[] = [];
		let used = 0;
		for (const card of visible) {
			const span = spanOf(card);
			if (used + span > columns) {
				row = [];
				used = 0;
			}
			row.push({ card, span });
			used += span;
		}

		// A sobra é par (ver o CSS), então metade dela é um número inteiro de colunas. O primeiro cartão
		// da linha ganha posição e largura; os seguintes vêm logo depois dele, sozinhos
		const offset = (columns - used) / 2;
		if (row.length > 0 && offset > 0) row[0].card.style.gridColumn = `${offset + 1} / span ${row[0].span}`;
	}

	centerLastRow();
	for (const query of ['(min-width: 40rem)', '(min-width: 64rem)']) {
		matchMedia(query).addEventListener('change', centerLastRow);
	}
</script>

<style>
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-6);
	}

	.filter {
		min-height: 2.75rem;
		padding: 0 var(--space-5);
		background: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		color: var(--color-text-muted);
		font-weight: var(--weight-semibold);
		cursor: pointer;
	}

	.filter:hover {
		color: var(--color-text);
	}

	.filter[aria-pressed='true'] {
		background-color: var(--color-accent);
		border-color: var(--color-accent);
		color: var(--color-on-accent);
	}

	/*
	 * Hierarquia da galeria: no celular, um cartão por linha; no tablet, dois; no desktop, os trabalhos
	 * principais (featured) ocupam metade da linha e os outros, um terço. Cartões escondidos pelo
	 * filtro saem do fluxo (hidden), e a grade se rearruma sozinha.
	 *
	 * As colunas são "finas" de propósito (4 no tablet, 12 no desktop): assim, a sobra da última linha
	 * é sempre um número par de colunas, e o script acima consegue centralizar essa linha exatamente.
	 */
	.grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
		padding: 0;
		list-style: none;
	}

	@media (min-width: 40rem) {
		.grid {
			grid-template-columns: repeat(4, 1fr);
		}

		.card {
			grid-column: span 2;
		}
	}

	@media (min-width: 64rem) {
		.grid {
			grid-template-columns: repeat(12, 1fr);
		}

		.card {
			grid-column: span 4;
		}

		.card.featured {
			grid-column: span 6;
		}

		.featured .card-title {
			font-size: var(--text-2xl);
		}
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: hidden;
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		transition:
			transform var(--duration-base) ease,
			border-color var(--duration-base) ease;
	}

	/* Cartão clicável (com JS): sobe um pouco e a borda acende */
	.card:has(.more:not([hidden])):is(:hover, :focus-within) {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--color-accent) 55%, var(--color-border));
	}

	.card-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-3);
		padding: var(--space-5);
		border-top: 1px solid var(--color-border);
	}

	.card-meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-2) var(--space-4);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.06em;
	}

	.kind {
		color: var(--color-text-muted);
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		color: var(--color-accent);
	}

	.status::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background-color: var(--color-accent);
	}

	.draft {
		align-self: start;
		padding: var(--space-1) var(--space-3);
		border: 1px dashed var(--color-accent);
		border-radius: var(--radius-full);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
	}

	.card-title {
		margin-top: var(--space-2);
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
	}

	/* Estágio atual: traço ciano à esquerda, para se destacar da descrição sem competir com o título */
	.stage {
		padding-left: var(--space-3);
		border-left: 2px solid var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		line-height: 1.5;
	}

	.description {
		color: var(--color-text-muted);
		font-size: var(--text-base);
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
		padding: 0;
		list-style: none;
	}

	.stack li {
		padding: var(--space-1) var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		font-size: var(--text-sm);
	}

	/* Rodapé "Ver detalhes ↗", sempre colado à base do cartão */
	.card-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: auto;
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-border);
	}

	.more {
		min-height: 2.75rem;
		padding: 0;
		background: none;
		border: 0;
		color: var(--color-text);
		font-weight: var(--weight-semibold);
		cursor: pointer;
	}

	/* Área de clique esticada: cobre o cartão inteiro sem virar um botão gigante para o leitor de tela */
	.more::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	/* O anel de foco vai para o cartão todo, que é a área clicável */
	.more:focus-visible {
		outline: none;
	}

	.card:has(.more:focus-visible) {
		outline: 3px solid var(--color-focus);
		outline-offset: 3px;
	}

	.arrow {
		width: 1rem;
		height: 1rem;
		color: var(--color-text-muted);
		transition:
			transform var(--duration-base) ease,
			color var(--duration-base) ease;
	}

	.card:is(:hover, :focus-within) .arrow {
		color: var(--color-accent);
		transform: translate(2px, -2px);
	}

	/* Projeto único: o cartão ocupa a largura toda, com a ilustração ao lado do texto */
	@media (min-width: 60rem) {
		.card:only-child {
			grid-column: 1 / -1;
			flex-direction: row;
		}

		.card:only-child > :global(.art) {
			flex: 1 1 0;
			aspect-ratio: auto;
			max-height: none;
		}

		.card:only-child .card-body {
			flex: 1.15 1 0;
			justify-content: center;
			padding: var(--space-7);
			border-top: 0;
			border-left: 1px solid var(--color-border);
		}

		.card:only-child .card-foot {
			margin-top: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card:has(.more:not([hidden])):is(:hover, :focus-within),
		.card:is(:hover, :focus-within) .arrow {
			transform: none;
		}
	}
</style>
