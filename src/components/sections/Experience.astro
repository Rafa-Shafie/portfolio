---
import type { CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import ExperienceCard from '../ExperienceCard.astro';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
	id: string;
	locale: Locale;
	entries: CollectionEntry<'experiences'>[];
}

const { id, locale, entries } = Astro.props;
const t = useTranslations(locale);
---

<Section id={id} title={t.experience.title}>
	<ol class="list">
		{
			entries.map((entry) => (
				<li>
					<ExperienceCard experience={entry.data} locale={locale} />
				</li>
			))
		}
	</ol>
</Section>

<style>
	.list {
		display: grid;
		gap: var(--space-5);
		padding: 0;
		list-style: none;
	}
</style>
