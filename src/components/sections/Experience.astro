---
/**
 * Seção "Experiências": uma lista de acordeões, um por experiência (src/content/experiences/).
 * A mais recente começa aberta. O cartão de cada uma, com o painel e o modal, fica em ExperienceCard.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '../Section.astro';
import ExperienceCard from '../ExperienceCard.astro';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
	id: string;
	number: string;
	locale: Locale;
	entries: CollectionEntry<'experiences'>[];
}

const { id, number, locale, entries } = Astro.props;
const t = useTranslations(locale);
---

<Section id={id} number={number} label={t.experience.label} heading={t.experience.heading}>
	<p slot="intro">{t.experience.intro}</p>
	<ol class="list">
		{
			entries.map((entry, i) => (
				<li>
					<ExperienceCard
						experience={entry.data}
						locale={locale}
						index={String(i + 1).padStart(2, '0')}
						open={i === 0}
						slug={entry.id}
					/>
				</li>
			))
		}
	</ol>
</Section>

<style>
	.list {
		padding: 0;
		list-style: none;
		border-bottom: 1px solid var(--color-border);
	}
</style>
