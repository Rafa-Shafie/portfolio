---
/**
 * Hero: o topo da página, com o nome (o único <h1>), o headline, os botões e o retrato.
 *
 * - <Picture> do Astro gera, no build, a foto em formatos modernos (AVIF e WebP, com JPEG de
 *   reserva) e em vários tamanhos. O navegador escolhe o menor arquivo que serve para a tela dele.
 *   É uma das razões do 100 em Performance: a foto é a maior imagem da página.
 * - Os botões chegam por <slot name="actions">: quem usa o Hero (o HomePage) decide quais botões
 *   entram. "Slot" é o espaço onde o componente pai encaixa conteúdo próprio.
 * - Ícones SVG importados viram componentes (<LocationIcon />): o desenho entra direto no HTML,
 *   sem requisição extra, e herda a cor do texto.
 */
import { Picture } from 'astro:assets';
import LocationIcon from 'bootstrap-icons/icons/geo-alt.svg';
import CodeIcon from 'bootstrap-icons/icons/code-slash.svg';
// Foto do retrato: para trocar, basta substituir este arquivo (proporção 4:5)
import photo from '../../assets/rafael.jpg';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const [captionFirst, captionSecond] = t.hero.portraitCaption.split('\n');
---

<section id="top" class="hero" aria-labelledby="hero-title">
	<div class="container hero-inner">
		<div class="hero-text">
			<p class="status">{t.hero.status}</p>
			<!-- "Rafael El" em cima e "Shafie" centralizado embaixo; o espaço entre os spans mantém o nome legível -->
			<h1 id="hero-title" class="name"><span>Rafael El</span> <span>Shafie</span></h1>
			<p class="headline">
				{
					t.hero.headline.split(' · ').map((part, i) => (
						<>
							{i > 0 && ' · '}
							<span>{part}</span>
						</>
					))
				}
			</p>
			<p class="intro">{t.hero.intro}</p>
			<!-- A prova da frase acima: a entrega mais forte, já na primeira tela. O ": " escondido faz o
			     leitor de tela ler "Último trabalho: Atlas…" (o rótulo fica numa linha própria só no visual) -->
			<p class="highlight">
				<span class="highlight-label">{t.hero.highlightLabel}</span><span class="visually-hidden">: </span>
				{t.hero.highlight}
			</p>
			<div class="actions">
				<slot name="actions" />
			</div>
			<p class="location"><LocationIcon aria-hidden="true" />{t.hero.location}</p>
		</div>

		<figure class="portrait">
			<Picture
				class="photo"
				src={photo}
				alt={t.hero.photoAlt}
				formats={['avif', 'webp']}
				widths={[320, 480, 640, 800]}
				sizes="(min-width: 60rem) 24rem, 20rem"
				loading="eager"
				fetchpriority="high"
			/>
			<!-- Rótulo e etiqueta são opcionais: com texto vazio no dicionário, não aparecem nesse idioma -->
			<figcaption>
				{t.hero.portraitLabel && <span class="portrait-label">{t.hero.portraitLabel}</span>}
				<span class="portrait-caption">{captionFirst}<br />{captionSecond}</span>
			</figcaption>
			{t.hero.portraitTag && <span class="portrait-tag" aria-hidden="true"><CodeIcon />{t.hero.portraitTag}</span>}
			<svg class="spark" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M12 2c.6 5.4 4.6 9.4 10 10-5.4.6-9.4 4.6-10 10-.6-5.4-4.6-9.4-10-10 5.4-.6 9.4-4.6 10-10z" />
			</svg>
		</figure>
	</div>
</section>

<style>
	.hero {
		padding-block: var(--space-8) var(--space-section);
		/* A etiqueta girada do retrato gerava 1px de rolagem horizontal por arredondamento */
		overflow-x: clip;
	}

	.hero-inner {
		display: grid;
		gap: var(--space-8);
		align-items: center;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.status::before {
		content: '';
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background-color: var(--color-accent);
		box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--color-accent) 18%, transparent);
	}

	/* Bloco do tamanho do conteúdo: "Shafie" centraliza sob "Rafael El" e o selo fica em cima */
	.name {
		display: grid;
		justify-items: center;
		width: fit-content;
		margin-top: var(--space-5);
		font-size: var(--text-display);
		font-weight: var(--weight-bold);
		letter-spacing: -0.035em;
		line-height: 0.98;
	}

	/* Headline e legenda da foto são identidade, não texto corrido: ficam na Poppins */
	.headline {
		margin-top: var(--space-5);
		color: var(--color-accent);
		font-family: var(--font-sans);
		font-size: var(--text-xl);
		font-weight: var(--weight-semibold);
	}

	/* Quebra de linha só entre os itens, nunca dentro de um */
	.headline span {
		white-space: nowrap;
	}

	.intro {
		max-width: 34rem;
		margin-top: var(--space-4);
		color: var(--color-text-muted);
	}

	/* Mesmo traço ciano do estágio dos projetos: "isto é um fato concreto" */
	.highlight {
		max-width: 34rem;
		margin-top: var(--space-5);
		padding-left: var(--space-4);
		border-left: 2px solid var(--color-accent);
	}

	.highlight-label {
		display: block;
		margin-bottom: var(--space-1);
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
		margin-top: var(--space-6);
	}

	.location {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-5);
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-label);
	}

	.location svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	/* Retrato em moldura levemente inclinada */
	.portrait {
		position: relative;
		justify-self: center;
		width: min(100%, 20rem);
		padding: var(--space-3) var(--space-3) var(--space-5);
		background-color: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		/* Sem sombra: no tema escuro, uma sombra preta sobre o fundo quase preto virava uma mancha de
		   outro tom atrás da moldura. A borda fina basta para destacar a moldura nos dois temas */
		transform: rotate(2deg);
	}

	.photo {
		width: 100%;
		aspect-ratio: 4 / 4.3;
		object-fit: cover;
		object-position: 50% 15%;
		border-radius: var(--radius-sm);
	}

	figcaption {
		display: grid;
		gap: var(--space-2);
		margin: var(--space-4) var(--space-2) 0;
	}

	.portrait-label {
		color: var(--color-text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.portrait-caption {
		padding-right: var(--space-7);
		font-family: var(--font-sans);
		font-size: var(--text-lg);
		font-weight: var(--weight-semibold);
		line-height: 1.35;
	}

	.portrait-tag {
		position: absolute;
		top: 58%;
		right: calc(-1 * var(--space-4));
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		background-color: var(--color-accent);
		border-radius: var(--radius-sm);
		box-shadow: 0 0.5rem 1.25rem var(--shadow-color);
		color: var(--color-on-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		font-weight: var(--weight-semibold);
		transform: rotate(-4deg);
	}

	.portrait-tag svg {
		width: 1rem;
		height: 1rem;
	}

	.spark {
		position: absolute;
		right: var(--space-5);
		bottom: var(--space-5);
		width: 1.75rem;
		fill: none;
		stroke: var(--color-accent);
		stroke-width: 1.6;
	}

	@media (min-width: 60rem) {
		.hero {
			padding-top: var(--space-9);
		}

		.hero-inner {
			grid-template-columns: 1.3fr 1fr;
		}

		.portrait {
			justify-self: end;
			width: 24rem;
		}
	}
</style>
