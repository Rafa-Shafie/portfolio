---
import MenuIcon from 'bootstrap-icons/icons/list.svg';
import CloseIcon from 'bootstrap-icons/icons/x-lg.svg';
import BrandMark from '../assets/brand/mark.svg';
import BrandWordmark from '../assets/brand/wordmark.svg';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations, type Locale } from '../i18n/utils';

interface Props {
	locale: Locale;
	links: { id: string; label: string }[];
}

const { locale, links } = Astro.props;
const t = useTranslations(locale);
---

<a class="skip-link" href="#main">{t.a11y.skipToContent}</a>

<header class="site-header">
	<div class="container header-inner">
		<!-- Marca em SVG; o nome acessível começa por "RafaShafie", o texto que aparece (WCAG 2.5.3) -->
		<a class="logo" href="#top">
			<BrandMark class="logo-mark" aria-hidden="true" />
			<BrandWordmark class="logo-word" aria-hidden="true" />
			<span class="visually-hidden">RafaShafie, {t.a11y.backToTop}</span>
		</a>

		{
			links.length > 0 && (
				<>
					<button
						class="menu-toggle"
						type="button"
						aria-expanded="false"
						aria-controls="site-nav"
						data-label-open={t.a11y.openMenu}
						data-label-close={t.a11y.closeMenu}
					>
						<MenuIcon class="icon icon-open" aria-hidden="true" />
						<CloseIcon class="icon icon-close" aria-hidden="true" />
						<span class="visually-hidden" data-menu-label>
							{t.a11y.openMenu}
						</span>
					</button>

					<!-- Gaveta no mobile, linha no desktop. Vem depois do botão para o Tab seguir a ordem visual -->
					<nav id="site-nav" class="site-nav" aria-label={t.a11y.mainNav} data-open="false">
						<ul>
							{links.map(({ id, label }) => (
								<li>
									<a href={`#${id}`}>{label}</a>
								</li>
							))}
						</ul>
					</nav>
				</>
			)
		}

		<div class="header-actions">
			<LanguageSwitcher locale={locale} />
			<ThemeToggle locale={locale} />
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	const nav = document.querySelector<HTMLElement>('#site-nav');
	const label = toggle?.querySelector<HTMLElement>('[data-menu-label]');

	if (toggle && nav && label) {
		const setOpen = (open: boolean) => {
			toggle.setAttribute('aria-expanded', String(open));
			nav.dataset.open = String(open);
			label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
		};
		const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

		toggle.addEventListener('click', () => setOpen(!isOpen()));

		// Escolher um destino fecha o menu
		nav.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) setOpen(false);
		});

		// Esc fecha e devolve o foco ao botão
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) {
				setOpen(false);
				toggle.focus();
			}
		});

		// Clique fora fecha
		document.addEventListener('click', (event) => {
			const target = event.target as Node;
			if (isOpen() && !nav.contains(target) && !toggle.contains(target)) setOpen(false);
		});

		// Ao passar para o layout de desktop, o estado do menu mobile é descartado
		matchMedia('(min-width: 60rem)').addEventListener('change', () => setOpen(false));

		// Seção ativa: a última cujo topo já passou de 35% da altura da janela. No fim da página vale
		// a última seção, que pode ser baixa demais para chegar até essa linha.
		const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')];
		const targets = links.map((link) => document.getElementById(link.hash.slice(1)));
		let frame = 0;

		const markCurrent = () => {
			frame = 0;
			const line = innerHeight * 0.35;
			const atBottom = innerHeight + scrollY >= document.documentElement.scrollHeight - 2;
			let current = -1;
			let best = -Infinity;
			targets.forEach((target, i) => {
				const top = target?.getBoundingClientRect().top ?? Infinity;
				if (top <= line && top > best) [current, best] = [i, top];
			});
			if (atBottom && scrollY > 0) {
				const tops = targets.map((target) => target?.getBoundingClientRect().top ?? -Infinity);
				current = tops.indexOf(Math.max(...tops));
			}
			links.forEach((link, i) => {
				if (i === current) link.setAttribute('aria-current', 'true');
				else link.removeAttribute('aria-current');
			});
		};
		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(markCurrent);
		};

		addEventListener('scroll', schedule, { passive: true });
		addEventListener('resize', schedule);
		markCurrent();
	}
</script>

<style>
	.skip-link {
		position: absolute;
		top: var(--space-2);
		left: var(--space-2);
		z-index: 100;
		padding: var(--space-2) var(--space-4);
		background-color: var(--color-accent);
		color: var(--color-on-accent);
		font-weight: var(--weight-semibold);
		border-radius: var(--radius-sm);
		transform: translateY(-200%);
	}

	.skip-link:focus {
		transform: none;
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--color-border);
	}

	.header-inner {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-height: var(--header-height);
	}

	.logo {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-height: 2.75rem;
		margin-right: auto;
		color: var(--color-text);
		text-decoration: none;
	}

	.logo-mark {
		width: 2.25rem;
		height: 2.25rem;
		flex: none;
		color: var(--color-accent);
	}

	.logo-word {
		height: 1.125rem;
		width: auto;
		flex: none;
		color: var(--color-text);
	}

	/* Abaixo de 360px não cabem marca + nome + menu + idioma: fica só o monograma */
	@media (max-width: 22.49rem) {
		.logo-word {
			display: none;
		}
	}

	@media (min-width: 30rem) {
		.logo-word {
			height: 1.25rem;
		}
	}

	/* R do monograma na cor do texto, como "Rafa"; o S e o contorno seguem o destaque (color) */
	.logo-mark :global(.mark-r) {
		fill: var(--color-text);
		stroke: var(--color-text);
	}

	/* Prepara a Fase 3: a cor de "Shafie" passa a vir do token */
	.logo-word :global(.accent) {
		fill: var(--color-accent);
		stroke: var(--color-accent);
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: var(--space-2);
	}

	.menu-toggle {
		display: inline-grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0;
		background: none;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		color: var(--color-text);
		cursor: pointer;
	}

	.icon {
		width: 1.5rem;
		height: 1.5rem;
	}

	.icon-close,
	.menu-toggle[aria-expanded='true'] .icon-open {
		display: none;
	}

	.menu-toggle[aria-expanded='true'] .icon-close {
		display: block;
	}

	.site-nav ul {
		list-style: none;
		padding: 0;
	}

	.site-nav a {
		display: block;
		color: var(--color-text-muted);
		font-weight: var(--weight-semibold);
		text-decoration: none;
		transition: color var(--duration-fast) ease;
	}

	.site-nav a:hover,
	.site-nav a[aria-current='true'] {
		color: var(--color-accent);
	}

	/* Mobile: o menu é uma gaveta logo abaixo do header */
	@media (max-width: 59.99rem) {
		.site-nav {
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background-color: var(--color-surface);
			border-bottom: 1px solid var(--color-border);
		}

		.site-nav[data-open='false'] {
			display: none;
		}

		.site-nav ul {
			padding-block: var(--space-2);
		}

		.site-nav a {
			padding: var(--space-3) var(--space-5);
			font-size: var(--text-lg);
		}

		/* Seção ativa: barra à esquerda, além da cor (WCAG 1.4.1) */
		.site-nav a[aria-current='true'] {
			box-shadow: inset 3px 0 0 currentColor;
		}
	}

	/* Desktop: marca à esquerda, links no centro, idioma à direita */
	@media (min-width: 60rem) {
		.header-inner {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
		}

		.logo-mark {
			width: 2.5rem;
			height: 2.5rem;
		}

		.logo-word {
			height: 1.375rem;
		}

		.menu-toggle {
			display: none;
		}

		.site-nav ul {
			display: flex;
			gap: var(--space-6);
		}

		.site-nav a {
			padding-block: var(--space-2);
			font-size: var(--text-base);
			/* Traço sob a seção ativa: a cor sozinha não pode ser a única pista (WCAG 1.4.1) */
			border-bottom: 2px solid transparent;
		}

		.site-nav a[aria-current='true'] {
			border-bottom-color: currentColor;
		}

		.header-actions {
			justify-self: end;
		}
	}
</style>
