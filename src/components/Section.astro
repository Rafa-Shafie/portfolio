---
interface Props {
	id: string;
	/** Posição da seção na página ("01"), calculada a partir das seções visíveis. */
	number: string;
	/** Rótulo curto, igual ao do menu ("Sobre"). */
	label: string;
	/** Título em frase; "\n" vira quebra de linha. */
	heading: string;
}

const { id, number, label, heading } = Astro.props;
const headingId = `${id}-title`;
const lines = heading.split('\n');
---

<section id={id} class="section" aria-labelledby={headingId}>
	<div class="container">
		<div class="section-head">
			<div>
				<p class="section-label">{number} / {label}</p>
				<h2 id={headingId} class="section-title">
					{lines.map((line, i) => (i > 0 ? [<br />, line] : line))}
				</h2>
			</div>
			{Astro.slots.has('intro') && (
				<div class="section-intro">
					<slot name="intro" />
				</div>
			)}
		</div>
		<slot />
	</div>
</section>

<style>
	.section {
		padding-block: var(--space-section);
	}

	.section-head {
		display: grid;
		gap: var(--space-5);
		align-items: end;
		margin-bottom: var(--space-7);
	}

	.section-label {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.section-title {
		margin-top: var(--space-3);
		font-size: var(--text-section);
		font-weight: var(--weight-semibold);
		letter-spacing: -0.03em;
		line-height: 1.12;
	}

	.section-intro {
		max-width: 26rem;
		color: var(--color-text-muted);
	}

	@media (min-width: 60rem) {
		.section-head {
			grid-template-columns: 1fr auto;
		}
	}
</style>
