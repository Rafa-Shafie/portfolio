---
interface Props {
	id: string;
	/** Posição da seção na página ("01"), calculada a partir das seções visíveis. */
	number: string;
	/** Rótulo curto, igual ao do menu ("Sobre"). */
	label: string;
	/** Título em frase; "\n" vira quebra de linha. */
	heading: string;
	/** "inverted": bloco com fundo de destaque (usado no contato). */
	variant?: 'default' | 'inverted';
}

const { id, number, label, heading, variant = 'default' } = Astro.props;
const headingId = `${id}-title`;
const lines = heading.split('\n');
---

<section id={id} class:list={['section', `section-${variant}`]} aria-labelledby={headingId}>
	<div class="container">
		<div class="section-head">
			<div>
				<p class="section-label">{number} / {label}</p>
				<h2 id={headingId} class="section-title">
					{lines.map((line, i) => (i > 0 ? [<br />, line] : line))}
				</h2>
			</div>
			{Astro.slots.has('intro') && (
				<div class="section-intro">
					<slot name="intro" />
				</div>
			)}
		</div>
		<slot />
	</div>
</section>

<script>
	// Revelação discreta ao rolar: só com JavaScript e sem pedido de menos movimento. O que já está
	// na tela ao carregar (o topo, ou a seção de um link com #âncora) aparece direto, sem animar.
	if (matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.remove('reveal-pending');
					observer.unobserve(entry.target);
				}
			},
			{ rootMargin: '0px 0px -10% 0px' },
		);
		for (const container of document.querySelectorAll<HTMLElement>('.section > .container')) {
			if (container.getBoundingClientRect().top < innerHeight) continue;
			container.classList.add('reveal', 'reveal-pending');
			observer.observe(container);
		}
	}
</script>

<style>
	/*
	 * Só opacidade e um deslocamento curto; termina sem transform (ver o padrão de clique dos cartões).
	 * A transição vale só para aparecer: ao marcar como pendente, a seção some na hora.
	 */
	.reveal:not(.reveal-pending) {
		transition:
			opacity 600ms ease-out,
			transform 600ms ease-out;
	}

	.reveal-pending {
		opacity: 0;
		transform: translateY(1rem);
	}

	@media print {
		.reveal-pending {
			opacity: 1;
			transform: none;
		}
	}

	.section {
		padding-block: var(--space-section);
	}

	.section-head {
		display: grid;
		gap: var(--space-5);
		align-items: end;
		margin-bottom: var(--space-7);
	}

	.section-label {
		color: var(--color-accent);
		font-family: var(--font-mono);
		font-size: var(--text-label);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.section-title {
		margin-top: var(--space-3);
		font-size: var(--text-section);
		font-weight: var(--weight-semibold);
		letter-spacing: -0.03em;
		line-height: 1.12;
	}

	.section-intro {
		max-width: 26rem;
		color: var(--color-text-muted);
	}

	/* Bloco invertido: a seção inteira com fundo de destaque, de borda a borda.
	   Texto e foco ficam escuros (o contorno ciano sumiria aqui) */
	.section-inverted {
		padding-block: clamp(3.5rem, 2.5rem + 3vw, 5rem) var(--space-7);
		background-color: var(--color-accent);
		color: var(--color-on-accent);
	}

	/* O contato fecha a página com destaque, mas abaixo do nome no hero */
	.section-inverted .section-title {
		margin-top: var(--space-3);
		/* Piso de 2.25rem: "¿Construimos" precisa caber em 320px */
		font-size: clamp(2.25rem, 1.5rem + 2.6vw, 3.75rem);
		font-weight: var(--weight-bold);
		letter-spacing: -0.035em;
		line-height: 0.98;
	}

	.section-inverted .section-head {
		margin-bottom: var(--space-6);
	}

	.section-inverted .section-label {
		color: var(--color-on-accent);
		/* 0,9 é o limite para 4,5:1 com texto branco sobre o ciano escuro do tema claro */
		opacity: 0.9;
	}

	.section-inverted .section-intro {
		color: var(--color-on-accent);
	}

	.section-inverted :global(:focus-visible) {
		outline-color: var(--color-on-accent);
	}

	@media (min-width: 60rem) {
		.section-head {
			grid-template-columns: 1fr auto;
		}
	}
</style>
