---
/**
 * Esqueleto de toda página: o <html> com o idioma, o <head> (SEO, Open Graph, fontes, tema e
 * analytics) e o <body> onde a página encaixa o conteúdo (<slot />).
 *
 * - canonical: o endereço "oficial" da página, para o Google não tratar variações como duplicatas.
 * - hreflang: as versões da mesma página nos outros idiomas.
 * - Open Graph (og:*): título, descrição e imagem que aparecem ao compartilhar o link.
 * - Os CSS globais são importados aqui para valer em todas as páginas.
 */
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { defaultLocale, htmlLang, locales, ogLocale, type Locale } from '../i18n/utils';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
	locale: Locale;
	title: string;
	description: string;
}

const { locale, title, description } = Astro.props;
const canonical = getAbsoluteLocaleUrl(locale);
const ogImageUrl = new URL(`/og/${locale}.png`, Astro.site);

// Web Analytics e Speed Insights da Vercel: sem cookies, então seguem a regra de privacidade.
// Os scripts só existem nos deploys da Vercel (VERCEL=1 no build); no CI e localmente dariam 404.
const vercelInsights = process.env.VERCEL === '1';
---

<!doctype html>
<html lang={htmlLang[locale]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<!-- A mesma página nos outros idiomas; x-default é a versão para quem não tem idioma correspondente -->
		{locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={getAbsoluteLocaleUrl(l)} />)}
		<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale)} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0b1117" />

		<!--
			Tema antes da primeira pintura (sem flash): a escolha salva ou, sem ela, a do sistema.
			Inline e síncrono de propósito; as cores repetem --color-bg de tokens.css.
		-->
		<script is:inline>
			(() => {
				const root = document.documentElement;
				let theme = null;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				}
				root.dataset.theme = theme;
				document.querySelector('meta[name="theme-color"]').content = theme === 'light' ? '#f8fafc' : '#0b1117';
			})();
		</script>
		<meta name="generator" content={Astro.generator} />

		<!-- Pré-carrega os pesos do texto e dos títulos; o 600 vem sob demanda -->
		<Font cssVariable="--font-poppins" preload={[{ weight: 400 }, { weight: 700 }]} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Rafael El Shafie" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale[locale]} />
		{locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />

		{
			vercelInsights && (
				<>
					<script is:inline defer src="/_vercel/insights/script.js"></script>
					<script is:inline defer src="/_vercel/speed-insights/script.js"></script>
				</>
			)
		}
	</head>
	<body>
		<slot />

		<!--
			Depois de trocar de idioma, volta à mesma seção e à mesma altura dentro dela (o seletor guarda
			a posição; ver LanguageSwitcher.astro). Módulo inline no fim do body: módulos rodam em ordem,
			então este roda depois dos scripts dos componentes, com o layout final (filtros, abas e
			botões que só aparecem com JS). As seções que ficam na tela aparecem direto, sem animação.
		-->
		<script type="module" is:inline>
			let saved = null;
			try {
				saved = JSON.parse(sessionStorage.getItem('language-switch-position') ?? 'null');
				sessionStorage.removeItem('language-switch-position');
			} catch {}
			const target = saved && typeof saved.progress === 'number' && document.getElementById(saved.id);
			if (target) {
				const header = document.querySelector('.site-header');
				const box = target.getBoundingClientRect();
				const line = header ? header.getBoundingClientRect().bottom : 0;
				scrollTo({ top: scrollY + box.top + saved.progress * box.height - line, behavior: 'instant' });
				for (const el of document.querySelectorAll('.reveal-pending')) {
					const { top, bottom } = el.getBoundingClientRect();
					if (top < innerHeight && bottom > 0) el.classList.remove('reveal', 'reveal-pending');
				}
			}
		</script>
	</body>
</html>
