---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	lang: string;
	ogLocale: string;
	/** Caminho da imagem Open Graph, ex.: /og/pt.png */
	ogImage: string;
}

const { title, description, lang, ogLocale, ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#0b1117" />
		<meta name="generator" content={Astro.generator} />

		<!-- Pré-carrega os pesos do texto e dos títulos; o 600 vem sob demanda -->
		<Font cssVariable="--font-poppins" preload={[{ weight: 400 }, { weight: 700 }]} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Rafael El Shafie" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body>
		<slot />
	</body>
</html>
